# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
.coverage.*

# Virtual environments
.venv/
venv/

# Environment / secrets
.env
.env.*
!.env.example

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Terraform (the .terraform.lock.hcl provider lock file IS committed)
infrastructure/**/.terraform/
infrastructure/**/*.tfstate
infrastructure/**/*.tfstate.*
infrastructure/**/*.tfplan
infrastructure/**/crash.log

# Alembic
migrations/versions/__pycache__/

# Docker / logs
*.log

# Prompt scratch files (not part of the delivered project)
promrt_1.md
prormt_2.md

# Local, machine-specific extra CA certificates (e.g. a corporate/AV TLS
# -inspection root) trusted by the Docker build -- see Dockerfile and
# docs/ENVIRONMENT_LIMITATIONS.md. Never commit a real cert here; the
# directory structure is preserved via certs/.gitkeep.
certs/*
!certs/.gitkeep
