# Copy to .env and adjust for local use. Never commit a real .env file.
#
# Every variable below is read by src/config.py::Settings (env prefix
# POLICYGUARD_) -- this is the one source of truth for the running app.
# See migrations/env.py for why standalone Alembic runs also accept a
# fallback DATABASE_URL, which is documented there and is not meant to be
# set here.

# Deployment environment label, surfaced in logs only (default: local).
POLICYGUARD_ENVIRONMENT=local

# Python logging level for the app (default: INFO).
POLICYGUARD_LOG_LEVEL=INFO

# PostgreSQL only -- SQLite is not supported anywhere in this project.
# In Docker Compose this points at the "db" service; for host-side direct
# `uvicorn` runs against the Compose db, use localhost instead of "db".
POLICYGUARD_DATABASE_URL=postgresql+psycopg://policyguard:policyguard@db:5432/policyguard

# AI provider: "mock" (default, fully offline/deterministic) or "external".
# "external" is a disabled stub in this POC -- do not point it at a real
# endpoint/key; leave the two variables below empty or as an obvious
# placeholder.
POLICYGUARD_AI_PROVIDER=mock
POLICYGUARD_AI_EXTERNAL_BASE_URL=
POLICYGUARD_AI_EXTERNAL_API_KEY=changeme-not-a-real-key

# AI-assurance confidence-gate thresholds (spec section 11).
POLICYGUARD_CONFIDENCE_APPROVAL_THRESHOLD=0.70
POLICYGUARD_CONFIDENCE_HARD_FLOOR=0.35

# Kill-switch mode seeded once at first startup if no row exists yet:
# "normal" | "paused" | "emergency_stop" (spec section 13). Changing this
# after the first row is created has no further effect -- use the admin
# kill-switch endpoint to change mode at runtime.
POLICYGUARD_KILL_SWITCH_DEFAULT_MODE=normal

# Max inbound JSON payload size in bytes.
POLICYGUARD_MAX_PAYLOAD_BYTES=1000000

# Shows a "DEMO / MOCK DATA" banner on the dashboard, and is the safety gate
# demo/scripts/seed_demo_data.py and reset_demo_data.py both require before
# they will write/delete anything (docs/OPERATIONS_AND_OBSERVABILITY.md has
# the full seed/reset walkthrough). Off by default -- never set this to
# "true" in a real deployment.
POLICYGUARD_DEMO_MODE=false

# Comma-separated list is not supported by pydantic's default list parsing
# from a plain env string; leave unset (defaults to an empty list = no CORS
# origins allowed) unless you configure a JSON array, e.g.
# POLICYGUARD_CORS_ALLOW_ORIGINS=["http://localhost:3000"]
POLICYGUARD_CORS_ALLOW_ORIGINS=[]

# PostgreSQL container credentials (docker-compose only -- placeholders,
# already the hardcoded local default, not a real secret).
POSTGRES_USER=policyguard
POSTGRES_PASSWORD=policyguard
POSTGRES_DB=policyguard
